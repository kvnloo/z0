{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/z0/schemas/host-profile.schema.json",
  "title": "Zer0OnboardHostProfile",
  "description": "host.json written by read-only DETECT (design §4). Facts and names only: no secret values, no file contents, $HOME written as ~. Detectors never raise: a missing tool is `absent`, an ambiguous signal is an `unknown`.",
  "type": "object",
  "required": ["version", "host_id", "detected_at", "os", "hardware", "toolchains", "harnesses"],
  "properties": {
    "version": { "const": 1 },
    "host_id": { "$ref": "#/$defs/host_id" },
    "detected_at": { "type": "string", "format": "date-time" },
    "os": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "enum": ["linux", "darwin"] },
        "arch": { "enum": ["x86_64", "arm64"] },
        "libc": { "enum": ["glibc", "musl", "darwin", "unknown"] },
        "libc_version": { "type": "string", "pattern": "^([0-9]+\\.[0-9]+)?$", "description": "glibc version, linux only; empty when unknown." },
        "distro": { "type": "string" },
        "pkg_manager": { "enum": ["pacman", "apt", "dnf", "apk", "brew", "none"] },
        "pep668": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": ["cpu", "ram_gib", "gpu"],
      "properties": {
        "cpu": {
          "type": "object",
          "required": ["logical", "physical"],
          "properties": {
            "logical": { "type": "integer", "minimum": 1 },
            "physical": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "ram_gib": { "type": "number", "minimum": 0 },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mount", "free_gib"],
            "properties": {
              "mount": { "$ref": "#/$defs/path" },
              "role": { "type": "array", "items": { "enum": ["z0_home", "home", "hf_home", "release_root", "candidate"] } },
              "free_gib": { "type": "number", "minimum": 0 },
              "total_gib": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "gpu": {
          "type": "object",
          "required": ["class"],
          "properties": {
            "class": { "enum": ["nvidia", "amd", "apple", "intel_mac", "cpu"] },
            "vram_gib": { "type": "number", "minimum": 0 },
            "driver": { "type": "string" },
            "cuda_max": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "rocm": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "desktop": { "enum": ["wayland", "x11", "hyprland", "aqua", "none"] },
        "audio_in": { "type": "boolean" },
        "systemd_user": { "type": "boolean" },
        "linger": { "type": "boolean" },
        "launchd": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "prepared_path": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "description": "Law T1: resolved toolchain and allowed-harness bin dirs, then $Z0_HOME toolchains, then system dirs. Every run, unit, env file and check gets exactly this PATH."
    },
    "revs": {
      "type": "object",
      "description": "Evidence that each registry pin exists on origin (dash gates D1/D2). Keys are pinned SHAs.",
      "propertyNames": { "pattern": "^[0-9a-f]{7,40}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "on_origin"],
        "properties": {
          "repo": { "type": "string" },
          "on_origin": { "enum": ["yes", "no", "unknown"] },
          "evidence": { "enum": ["mirror", "checkout", "none"] },
          "flavour": { "enum": ["current", "legacy", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "python_window": { "enum": ["present", "makeable", "impossible"], "description": "A python in [3.10, 3.14): kernel.PyWindow." },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "enum": ["present", "absent"] },
          "path": { "$ref": "#/$defs/path" },
          "version": { "type": "string" },
          "sh_resolves": { "type": "boolean", "description": "Resolves under `sh -c 'command -v X'` with the prepared PATH (T1)." },
          "source": { "enum": ["path", "well_known_dir", "z0_toolchain", "version_manager", "z0_bootstrap"], "description": "z0_bootstrap: the python3 that stage 0 made ($Z0_HOME/venv or the bootstrap CPython), used when python3 is absent or outside [3.10, 3.14)." }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "tailscale": {
      "type": "object",
      "properties": {
        "installed": { "type": "boolean" },
        "logged_in": { "type": "boolean" },
        "ipv4": { "type": "string", "pattern": "^100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3}$", "description": "Only from this detection, inside 100.64.0.0/10 (H2)." },
        "magicdns": { "type": "string" }
      },
      "additionalProperties": false
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "enum": ["installed", "config_only", "absent"], "description": "installed only when the binary resolves (§2.3)." },
          "version": { "type": "string" },
          "config_dirs": { "type": "array", "items": { "$ref": "#/$defs/path" } },
          "sessions_present": { "type": "boolean", "description": "Existence only; session contents are never read." },
          "overrides": {
            "type": "object",
            "propertyNames": { "enum": ["CLAUDE_CONFIG_DIR", "CODEX_HOME", "PI_CODING_AGENT_DIR", "HERMES_HOME"] },
            "additionalProperties": { "$ref": "#/$defs/path" }
          },
          "policy_excluded": { "type": "boolean" },
          "path": { "$ref": "#/$defs/path", "description": "The resolved binary of an allowed, installed harness." },
          "bin_dir": { "$ref": "#/$defs/path", "description": "P1: the first dir that holds a policy-excluded (`configure: never`) binary (kept for compatibility; see bin_dirs)." },
          "bin_dirs": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "P1: every search or prepared-PATH dir that holds a policy-excluded binary; the plan keeps each of them off the prepared PATH." }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "candidates", "safe_default"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["harness_classify", "config_dir_pick", "fork_match", "port_owner", "gpu_vendor_resolve", "pkg_hint", "failure_triage"] },
          "facts": { "type": "object", "description": "Redacted facts: names, symlink targets, shebang lines. Never file contents or env values." },
          "candidates": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "safe_default": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "checkouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "origin"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "origin": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "description": "Normalized owner/repo." },
          "dirty": { "type": "integer", "minimum": 0 },
          "branch": { "type": "string" },
          "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "pin_present": { "type": "boolean" },
          "pin_is_ancestor": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "manager"],
            "properties": {
              "name": { "type": "string" },
              "manager": { "enum": ["systemd_user", "launchd"] },
              "active": { "type": "boolean" },
              "exec_root_kind": { "enum": ["release", "owned_venv", "toolchain", "checkout", "build_tree", "other"] },
              "deployed_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
            },
            "additionalProperties": false
          }
        },
        "port_owners": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]{1,5}$" },
          "additionalProperties": { "type": "string", "description": "Owning unit or process name, never a cmdline with arguments." }
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "description": "Names only. A value cannot be expressed.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.~/-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["present"],
        "properties": {
          "present": { "type": "boolean" },
          "mode_ok": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "recorded_host_id": { "$ref": "#/$defs/host_id" },
        "host_match": { "enum": ["fresh", "same", "other"], "description": "kernel.HostMatch; `other` refuses (H1)." },
        "stamps": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "owned": {
          "type": "array",
          "description": "Registry step paths (creates / probe.exists) that already exist; stat only. Drives already_satisfied and law I1.",
          "items": { "type": "string", "pattern": "^(~(/|$)|\\$Z0_HOME(/|$)|/(?!home/|Users/))" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "host_id": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "sha256(machine-id || hostname)[:16]." },
    "path": { "type": "string", "pattern": "^(~(/|$)|/(?!home/|Users/))" }
  }
}
