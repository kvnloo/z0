#!/usr/bin/env bash
# Structural validation of the federated registry. No network access.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${ROOT}/lib${PYTHONPATH:+:$PYTHONPATH}"
export Z0_ROOT="${ROOT}"
python3 - <<'PY'
import json
from pathlib import Path

import yaml

from z0 import registry

problems = registry.validate()
comps = registry.components()
ups = registry.upstreams()
srcs = registry.sources()
refs = registry.reference_only()
profs = registry.profiles()

# Profile expansion must only ever yield installable (owned) components.
for name in profs:
    for cid in registry.resolve_profile(name):
        assert cid in comps, f"profile {name} resolves non-installable {cid}"

assert not any(c in ups or c in srcs or c in refs for c in comps), \
    "component id collides with a non-installable entity class"

# The almanac must account for every entity the current-state sweep observed.
# A repo that exists and is not classified is exactly how the registry drifted
# into describing three generations of the architecture at once.
# Z0_ROOT is exported by the wrapper: this script runs on stdin, so __file__
# is <stdin> and deriving the repo root from it silently points elsewhere.
import os

# The canonical map must account for every entity class and every typed edge.
#
# `zer0.registry.yaml` omitted `reference_only` in EVERY commit it has ever had:
# 10 of 55 entities, including `hermes-k8s-lab` and the whole company-OS
# generation. `generated/almanac.json` carried them the whole time, so nothing
# failed -- the two generated artifacts disagreed and no check compared them.
# A map that silently drops 18% of the architecture is not canonical, and
# `docs-check` cannot see it because the generator is self-consistent.
_map = yaml.safe_load((Path(os.environ["Z0_ROOT"]) / "zer0.registry.yaml").read_text())
_almanac = json.loads(
    (Path(os.environ["Z0_ROOT"]) / "generated" / "almanac.json").read_text())
for _cls in ("components", "upstreams", "sources", "reference_only"):
    _missing = sorted(set(_almanac.get(_cls) or {}) - set(_map.get(_cls) or {}))
    assert not _missing, f"canonical map omits {_cls}: {_missing}"
for _sec in ("profiles", "interfaces"):
    _missing = sorted(set(_almanac.get(_sec) or {}) - set(_map.get(_sec) or {}))
    assert not _missing, f"canonical map omits {_sec}: {_missing}"
assert len(_map.get("relationships") or []) == len(_almanac.get("relationships") or []), (
    "canonical map and almanac disagree on the number of typed edges: "
    f"{len(_map.get('relationships') or [])} vs {len(_almanac.get('relationships') or [])}"
)

ledger = Path(os.environ["Z0_ROOT"]) / "audit" / "reality-ledger.json"
if ledger.is_file():
    swept = {e["id"] for e in json.loads(ledger.read_text())["entities"]}
    known = registry.known_ids()
    unaccounted = sorted(swept - known)
    invented = sorted(known - swept)
    for rid in unaccounted:
        problems.append(f"swept entity {rid!r} is not classified in the almanac")
    for rid in invented:
        problems.append(f"almanac entity {rid!r} was never observed by the sweep")

if problems:
    print(f"registry-check: {len(problems)} problem(s)")
    for p in problems:
        print(f"  ! {p}")
    raise SystemExit(1)

total = len(comps) + len(ups) + len(srcs) + len(refs)
print(f"ok: {len(comps)} owned components, {len(ups)} upstreams, "
      f"{len(srcs)} delegated sources, {len(refs)} reference-only "
      f"({total} entities), {len(profs)} profiles")
PY
