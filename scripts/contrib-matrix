#!/usr/bin/env bash
# Run the agent-in-the-loop acceptance matrix (contributor spec §4.3) and decide the
# `contrib_ready` completion law on its receipts.
#
#   scripts/contrib-matrix --z0int-sha SHA [--parallel N] [--harness claude,codex]
#                          [--profiles frontend,ml-research,systems-rust] [--runs 3]
#
# Every cell (scripts/onboard-agent-e2e) shares one candidate pair: the z0 candidate commit
# is deterministic (fixed dates), so all receipts name the same z0_sha. Receipts are copied
# into $E2E_WORK/receipts/, then scripts/contrib_ready.py prints READY / NOT_READY / BLOCKED.
# Cells already passed for the pair are not re-run.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
Z0INT_SHA="" PAR=1 HARNESSES="claude,codex" PROFILES="frontend,ml-research,systems-rust" RUNS=3
while (($#)); do
  case "$1" in
    --z0int-sha) Z0INT_SHA="$2"; shift 2 ;;
    --parallel) PAR="$2"; shift 2 ;;
    --harness) HARNESSES="$2"; shift 2 ;;
    --profiles) PROFILES="$2"; shift 2 ;;
    --runs) RUNS="$2"; shift 2 ;;
    *) echo "contrib-matrix: unknown argument $1" >&2; exit 2 ;;
  esac
done
[[ -n "$Z0INT_SHA" ]] || { echo "--z0int-sha is required" >&2; exit 2; }
WORK="${E2E_WORK:-$ROOT/.e2e-agent}"
mkdir -p "$WORK/receipts"
cells=()
for h in ${HARNESSES//,/ }; do for p in ${PROFILES//,/ }; do for r in $(seq 1 "$RUNS"); do
  cells+=("$h $p $r")
done; done; done
run_cell() {
  local h="$1" p="$2" r="$3" cell="agent.$1.$2.run$3"
  if [[ -f "$WORK/receipts/$cell.json" ]] && grep -q '"status": "pass"' "$WORK/receipts/$cell.json"; then
    echo "$cell: already passed"; return 0
  fi
  local w="$WORK/cells/$cell"
  mkdir -p "$w"
  E2E_WORK="$w" "$ROOT/scripts/onboard-agent-e2e" --harness "$h" --profile "$p" --run "$r" \
    --z0int-sha "$Z0INT_SHA" > "$w/run.log" 2>&1 || true
  cp "$w/out/$cell.json" "$WORK/receipts/$cell.json" 2> /dev/null || echo "$cell: no receipt"
  tail -2 "$w/run.log" | head -1
}
i=0
for c in "${cells[@]}"; do
  run_cell $c &
  i=$((i + 1))
  if ((i % PAR == 0)); then wait; fi
done
wait
Z0_SHA="$(python3 -c 'import json,glob,sys; print(next((json.load(open(f))["z0_sha"] for f in glob.glob(sys.argv[1]+"/agent.*.json")), ""))' "$WORK/receipts")"
echo "candidate pair: z0 $Z0_SHA, z0intelligence $Z0INT_SHA"
python3 "$ROOT/scripts/contrib_ready.py" --z0 "$Z0_SHA" --z0int "$Z0INT_SHA" --receipts "$WORK/receipts"
