#!/usr/bin/env python3
"""Fail when a repo emits a schema id belonging to another repo's namespace.

A namespace mismatch is not automatically a defect. It is one of:

  adapter_output  repo A emits repo B's contract because B consumes it
  shared          two repos genuinely share a subsystem name
  inversion       repo A emits its OWN artifact under B's namespace

The id string cannot distinguish these, and guessing from the pattern is how a
previous scan produced 30 false "inversions" and nearly renamed live contracts —
including one carried by a FROZEN artifact corpus. So classification lives in
`registry/schema_namespaces.yaml`, declared with evidence, and this check fails
only on emissions that are **not declared at all**.

Deliberately NOT wired into `docs-check`: it needs sibling checkouts that CI may
not have, and a missing checkout must not fail a build. Run it by hand, or from a
scheduled job, after any change to a schema id.

Usage:
    ./scripts/schema-namespace-check                      # auto-detect siblings
    ./scripts/schema-namespace-check --root DIR --root DIR
    ./scripts/schema-namespace-check --json
"""

from __future__ import annotations

import argparse
import collections
import json
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "registry" / "schema_namespaces.yaml"

SOURCE_SUFFIXES = {".py", ".ts", ".tsx"}
OUTPUT_DIRS = {"node_modules", ".venv", ".git", "__pycache__", "results",
               "site", "build", "dist", ".next", "out"}

# A schema id is declared in more than one syntactic form, and matching only
# the quoted-dict-key form hid a third of them:
#
#   "schema": "z0int.thing.v1"     dict key (quoted)      <- originally the only one
#   schema: "z0int.thing.v1"       dict key (TS, unquoted)
#   SCHEMA = "z0int.thing.v1"      module constant        <- invisible before
#   schema="z0int.thing.v1"        keyword argument       <- invisible before
#
# Constants were the real gap: `export_z0int.py` and `l2_benchmark.py` both
# declare `SCHEMA = "z0int...."`, so those ids never entered the register.
#
# Deliberately NOT a bare "any string that looks like an id" match: that flags
# test assertions and docstrings which legitimately NAME a forbidden id in order
# to assert its absence.
# ...but the GRAMMAR excluded a real id. `hotl-0.2` is AODL's wire contract,
# declared as `WIRE_SPEC = "hotl-0.2"` and named in its own spec as "the wire
# id". The pattern above requires `<ns>.<thing>.v<major>`, so `hotl-0.2` could
# not match ANY declaration form -- adding a `WIRE_SPEC` pattern changed nothing,
# because the id itself was unrepresentable. The registry would have gone on
# reporting a contract nobody emits while its declaration sat in the tree.
#
# Two accepted shapes now:
#   <ns>.<thing>.v<major>   z0int.thing.v1, z0eval.study.v1
#   <ns>-<major>.<minor>    hotl-0.2
# Both are anchored on a lowercase namespaced prefix, which is what keeps
# test assertions and docstrings out (they legitimately NAME forbidden ids).
_ID = (r'([a-z][a-z0-9_-]*\.[a-z0-9._-]+\.v[0-9]+[a-z0-9._-]*'
       r'|[a-z][a-z0-9_-]*-[0-9]+\.[0-9]+[a-z0-9._-]*)')
# Every form a schema id is actually declared in. This set has now been
# incomplete twice, both times hiding real declarations:
#
#   * `schema` as a dict key only, missing `SCHEMA = "..."` constants (90 ids)
#   * `schema` only, missing `schema_version` and JSON-Schema `const`
#
# `"const": "z0eval.study.v1"` in z0evals' study manifest is the declaration of a
# REGISTERED contract, and a check that could not see it reported the contract as
# emitted by nobody. A false positive of exactly that shape is why the interface
# cross-check below is trustworthy only if this table is.
#
# `$id` is deliberately absent: its values are mostly `#/definitions/...`
# pointers and `https://...` URLs, neither of which is an `<owner>.<thing>.v<n>`
# id. Adding it would import 30 non-ids to catch 0.
SCHEMA_LITERAL_PATTERNS = (
    re.compile(r'["\']schema["\']\s*:\s*["\']' + _ID + r'["\']'),
    re.compile(r'\bschema\s*:\s*["\']' + _ID + r'["\']'),
    re.compile(r'["\']schema_version["\']\s*:\s*["\']' + _ID + r'["\']'),
    re.compile(r'["\']schemaVersion["\']\s*:\s*["\']' + _ID + r'["\']'),
    re.compile(r'["\']const["\']\s*:\s*["\']' + _ID + r'["\']'),
    re.compile(r'\b[A-Za-z_]*SCHEMA[A-Za-z_]*\s*=\s*["\']' + _ID + r'["\']'),
    # AODL declares its wire contract as `WIRE_SPEC = "hotl-0.2"`. The name
    # contains SPEC, not SCHEMA, so the pattern above misses it -- and the
    # general `*_SPEC =` form was rejected as too loose: it matches
    # `special_tokens_map.json` and `specialist` in vendored tokenizer configs.
    # `WIRE_SPEC` occurs exactly once in the ecosystem, and it is this one.
    re.compile(r'\bWIRE_SPEC\s*=\s*["\']' + _ID + r'["\']'),
    re.compile(r'\bschema\s*=\s*["\']' + _ID + r'["\']'),
)

# checkout directory basename -> repo id used in the registry
REPO_IDS = {
    "z0": "z0", "openjev": "z0intelligence", "z0evals": "z0evals",
    "kerdoios": "kerdoios", "tokenomics": "tokenomics", "aodl": "aodl",
    "evolution-lab": "evolution-lab", "z0archy": "z0archy",
    "frontier-kb": "frontier-kb", "verified-oss-loop": "verified-oss-loop",
    "hermes-k8s-lab": "hermes-k8s-lab", "k8s-maintainer": "k8s-maintainer",
}

SEARCH_PARENTS = ("/home/kvn/tmp", "/mnt/zer0models/repos/kvnloo",
                  "/mnt/zer0models/workspace", "/mnt/zer0models/workspace/zer0/oss/.work")


def load_registry() -> dict:
    if not REGISTRY.is_file():
        raise SystemExit(f"missing {REGISTRY.relative_to(ROOT)}")
    return yaml.safe_load(REGISTRY.read_text(encoding="utf-8")) or {}


def discover_roots(explicit: list[str]) -> dict[str, Path]:
    if explicit:
        return {REPO_IDS.get(Path(p).name, Path(p).name): Path(p) for p in explicit}
    found: dict[str, Path] = {}
    for parent in SEARCH_PARENTS:
        base = Path(parent)
        if not base.is_dir():
            continue
        for child in sorted(base.iterdir()):
            if not child.is_dir():
                continue
            rid = REPO_IDS.get(child.name)
            if rid and rid not in found and (child / ".git").exists():
                found[rid] = child
    return found


def namespace_of(sid: str, owners: dict, shared) -> str:
    """The declared namespace an id belongs to.

    Not `sid.split(".")[0]`. That assumes `<ns>.<thing>.<version>`, and AODL's
    real wire id is `hotl-0.2` -- the version is hyphenated, so splitting on the
    first dot yields `hotl-0`, a namespace that does not exist, and a correct id
    is reported as belonging to an undeclared namespace.

    Longest declared prefix wins, accepting either separator. Falls back to the
    first dot-segment so an undeclared namespace is still NAMED rather than
    silently dropped.
    """
    best = ""
    for ns in list(owners) + list(shared):
        if sid == ns or sid.startswith(ns + ".") or sid.startswith(ns + "-"):
            if len(ns) > len(best):
                best = ns
    return best or sid.split(".", 1)[0]


def load_interfaces() -> dict:
    """The registered contracts, so the ids found in code can be compared to them."""
    path = ROOT / "registry" / "interfaces.yaml"
    try:
        return (yaml.safe_load(path.read_text(encoding="utf-8")) or {}).get("interfaces", {}) or {}
    except (OSError, yaml.YAMLError):
        return {}


def emitted_ids(root: Path) -> set[str]:
    ids: set[str] = set()
    for path in root.rglob("*"):
        if path.suffix not in SOURCE_SUFFIXES:
            continue
        if OUTPUT_DIRS & set(path.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for pattern in SCHEMA_LITERAL_PATTERNS:
            ids.update(m.group(1) for m in pattern.finditer(text))
    return ids


def analyse(roots: dict[str, Path], reg: dict) -> dict:
    owners = reg.get("owners") or {}
    shared = set(reg.get("shared") or {})
    declared = set()
    for entry in (reg.get("cross_owner") or []):
        if not isinstance(entry, dict):
            continue
        base = str(entry.get("id", "")).split("@", 1)[0]
        emitters = entry.get("emitted_by")
        if isinstance(emitters, str):
            emitters = [emitters]
        for emitter in emitters or []:
            declared.add((base, emitter))
    declared_inversions = {
        e["id"].split("@", 1)[0]
        for e in (reg.get("cross_owner") or [])
        if isinstance(e, dict) and e.get("kind") == "inversion"
    }

    undeclared: list[dict] = []
    inversions: list[dict] = []
    adapters: list[dict] = []
    totals = collections.Counter()
    unknown: dict[str, set[str]] = collections.defaultdict(set)

    ids_by_repo: dict[str, list[str]] = {}
    for repo, root in sorted(roots.items()):
        try:
            ids = emitted_ids(root)
        except OSError:
            continue
        ids_by_repo[repo] = sorted(ids)
        totals[repo] = len(ids)
        for sid in sorted(ids):
            ns = namespace_of(sid, owners, shared)
            owner_repo = owners.get(ns)
            if owner_repo is None:
                # An unknown namespace was previously SKIPPED, which made every
                # emission under it invisible -- the same shape of blind spot as
                # matching only one declaration form. Report it instead of
                # ignoring it: naming it is how it gets an owner.
                if ns not in shared:
                    unknown[ns].add(repo)
                continue
            if ns in shared:
                continue
            if owner_repo == repo:
                continue
            record = {"id": sid, "namespace": ns, "emitted_by": repo,
                      "namespace_owner": owner_repo}
            if (sid, repo) in declared:
                (inversions if sid in declared_inversions else adapters).append(record)
            else:
                undeclared.append(record)

    # ---- registered contracts vs the ids actually emitted -------------------
    #
    # `registry/interfaces.yaml` names 23 contracts. Nothing compared them to what
    # the checkouts emit, so the two could be -- and were -- almost disjoint:
    # 2 of 146 emitted ids matched a registered contract, and 17 of the 23
    # contracts are emitted by nothing anywhere, including by their own declared
    # owner. A "canonical contract map" that describes contracts nobody writes is
    # a list of names.
    emitted_by: dict[str, set[str]] = collections.defaultdict(set)
    for repo, ids in ids_by_repo.items():
        for sid in ids:
            emitted_by[sid].add(repo)

    # A `source` on a contract is a claim about where it is declared. Unverified
    # claims are what this whole report is about, so the claim is checked
    # wherever the owning repo is checked out. Where it is not, the claim is
    # unverifiable here rather than wrong.
    source_missing: list[dict] = []
    without_source: list[str] = []
    for iid, meta in sorted(load_interfaces().items()):
        if (meta or {}).get("class") == "superseded_alias":
            continue
        src = (meta or {}).get("source")
        if not src:
            without_source.append(iid)
            continue
        ns = iid.split(".", 1)[0]
        repo = owners.get(ns)
        root = roots.get(repo) if repo else None
        if root is None:
            continue
        if not (root / str(src)).is_file():
            source_missing.append({"id": iid, "source": src, "repo": repo})

    not_emitted: list[dict] = []
    bad_namespace: list[dict] = []
    for iid, meta in sorted(load_interfaces().items()):
        # A superseded alias is a historical SPELLING, not a namespace. Its id
        # deliberately does not follow `<owner>.<thing>`, so checking it against
        # the namespace table would report the spelling rather than a fault.
        if (meta or {}).get("class") == "superseded_alias":
            continue
        ns = namespace_of(iid, owners, shared)
        if ns not in owners and ns not in shared:
            # Decidable without looking at any artifact, and previously
            # unexamined: the check only walked EMITTED ids, so a contract under
            # an undeclared namespace was invisible whenever nothing emitted it --
            # and 8 of the 23 registered interfaces are emitted by nobody.
            bad_namespace.append({"id": iid, "namespace": ns,
                                  "declared_owner": (meta or {}).get("owner")})
        if not emitted_by.get(iid):
            not_emitted.append({"id": iid, "namespace": ns,
                                "declared_owner": (meta or {}).get("owner")})

    return {
        "schema": "z0.schema_namespace_check.v1",
        "roots": {k: str(v) for k, v in roots.items()},
        "ids_scanned": dict(totals),
        # The schema map: every id each checkout emits. Machine-readable, and the
        # evidence for everything else in this report.
        "ids_by_repo": ids_by_repo,
        "undeclared": undeclared,
        "known_inversions": inversions,
        "declared_adapter_output": adapters,
        "unknown_namespaces": {k: sorted(v) for k, v in sorted(unknown.items())},
        "interfaces_registered": len(load_interfaces()),
        "interfaces_not_emitted": not_emitted,
        "interfaces_without_source": without_source,
        "interface_source_missing": source_missing,
        "interface_undeclared_namespace": bad_namespace,
        # A contract emitted by a repo that does not own its namespace is a
        # decidable ownership fault, so it fails. A contract nobody emits is not
        # decidable here -- it may be a normative name for an interface with no
        # serialized artifact yet -- so it is reported for a decision instead.
        "ok": not undeclared and not bad_namespace and not source_missing,
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", action="append", default=[])
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    reg = load_registry()
    roots = discover_roots(args.root)
    if not roots:
        print("no checkouts found to scan", file=sys.stderr)
        return 0

    report = analyse(roots, reg)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return 0 if report["ok"] else 1

    print(f"scanned {len(roots)} checkouts: "
          f"{sum(report['ids_scanned'].values())} schema ids\n")

    if report["declared_adapter_output"]:
        print(f"declared adapter output ({len(report['declared_adapter_output'])}) — correct:")
        for r in report["declared_adapter_output"]:
            print(f"  {r['id']:<46} {r['emitted_by']} -> {r['namespace_owner']}")

    if report["known_inversions"]:
        print(f"\nknown inversions ({len(report['known_inversions'])}) — recorded debt, "
              f"each needs an owner decision:")
        for r in report["known_inversions"]:
            print(f"  {r['id']:<46} emitted by {r['emitted_by']}, owned by {r['namespace_owner']}")

    if report["undeclared"]:
        print(f"\nUNDECLARED cross-owner emissions ({len(report['undeclared'])}):")
        for r in report["undeclared"]:
            print(f"  {r['id']:<46} emitted by {r['emitted_by']}, owned by {r['namespace_owner']}")
        print("\nDecide for each: adapter output, shared namespace, or inversion —")
        print("then declare it in registry/schema_namespaces.yaml with evidence.")
        print("Do NOT classify from the name pattern alone.")
        return 1

    if report["unknown_namespaces"]:
        print(f"\nnamespaces with no declared owner ({len(report['unknown_namespaces'])}) -- "
              f"emissions under these are NOT checked:")
        for ns, repos in report["unknown_namespaces"].items():
            print(f"  {ns:<24} emitted by {repos}")
        print("Add each to `owners:` (or `shared:`) in registry/schema_namespaces.yaml.")
        print("This is reported, not failed: an unowned namespace may be legitimate.")

    if report["interface_source_missing"]:
        print(f"\nCONTRACT SOURCE MISSING ({len(report['interface_source_missing'])}): the "
              f"registry names a file that is not there:")
        for r in report["interface_source_missing"]:
            print(f"  {r['id']:<46} {r['repo']}/{r['source']}")
        print("Fix the path or the claim.")
        return 1

    if report["interface_undeclared_namespace"]:
        print(f"\nREGISTERED CONTRACTS IN AN UNDECLARED NAMESPACE "
              f"({len(report['interface_undeclared_namespace'])}):")
        for r in report["interface_undeclared_namespace"]:
            print(f"  {r['id']:<46} namespace {r['namespace']!r}, "
                  f"declared owner {r['declared_owner']}")
        print("Declare the namespace in registry/schema_namespaces.yaml (owners or")
        print("shared), or fix the contract id. A registered contract under an")
        print("unowned namespace is a claim about nothing.")
        return 1

    if report["interfaces_without_source"]:
        print(f"\n{len(report['interfaces_without_source'])} of "
              f"{report['interfaces_registered']} contracts declare no `source`, so there is "
              f"no file to check their claim against")

    if report["interfaces_not_emitted"]:
        print(f"\nCONTRACTS NO CHECKOUT EMITS ({len(report['interfaces_not_emitted'])} of "
              f"{report['interfaces_registered']}) -- in any form SCHEMA_LITERAL_PATTERNS "
              f"recognises:")
        for r in report["interfaces_not_emitted"]:
            print(f"  {r['id']:<46} declared owner {r['declared_owner']}")
        print("Each is either a normative name for an interface with no serialized")
        print("artifact, or a claim nobody can check. Decide which, per contract.")
        print("This is reported, not failed: the registry cannot know which it is.")

    print("\nok: every cross-owner emission is declared")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
